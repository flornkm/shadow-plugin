{
  "name": "shadow-plugin",
  "version": "0.0.0-development",
  "description": "TailwindCSS plugin for adding nice looking shadows.",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cat src/shadows.css src/shadow-ring.css src/elevation.css > dist/shadow-plugin.css && cat src/unprefixed.css src/shadow-ring.css src/elevation.css > dist/shadow-plugin.unprefixed.css",
    "pretest": "npm run build",
    "test": "node --test",
    "format": "prettier --write --ignore-unknown .",
    "demo": "open demo/index.html"
  },
  "exports": {
    ".": "./dist/shadow-plugin.css",
    "./unprefixed": "./dist/shadow-plugin.unprefixed.css"
  },
  "main": "./dist/shadow-plugin.css",
  "files": [
    "dist"
  ],
  "keywords": [
    "shadow",
    "tailwind shadow",
    "css shadow",
    "smooth shadow",
    "pure css shadow",
    "tailwind pure css plugin",
    "tailwindcss"
  ],
  "repository": "flornkm/shadow-plugin",
  "homepage": "https://shadow.floriankiem.com",
  "bugs": {
    "url": "https://github.com/flornkm/shadow-plugin/issues"
  },
  "author": {
    "name": "flornkm",
    "website": "https://floriankiem.com"
  },
  "license": "MIT",
  "prettier": {
    "printWidth": 100
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
